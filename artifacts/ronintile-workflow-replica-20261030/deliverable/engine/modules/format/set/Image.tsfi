<?xml version="1.0" encoding="UTF-8"?>
<format name="Image">

	<image-file><!----><name><var v="export_name"/>.png</name>
			<!----><width expression="x0*x1"><x v="set_width"/><x v="tile_width"/></width>
			<!----><height expression="x0*x1"><x v="set_height"/><x v="tile_height"/></height><!----><image-contents>	<!--
	|--><image-loop foreach="tile"><as i="_tile"/><image-contents>
<!--|-->	<ivar v="_tile.image">
<!--|-->		<grid-x expression="x0*x1"><x v="_tile.x"/><x v="tile_width"/></grid-x>
<!--|-->		<grid-y expression="x0*x1"><x v="_tile.y"/><x v="tile_height"/></grid-y>
<!--|-->	</ivar>
<!--|--></image-contents></image-loop><!--
	|||||||||||||||||||||||||||||||||--></image-contents></image-file>

</format>