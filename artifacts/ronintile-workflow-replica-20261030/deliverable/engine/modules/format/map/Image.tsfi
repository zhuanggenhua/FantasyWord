<?xml version="1.0" encoding="UTF-8"?>
<format name="Image">

	<image-file><!----><name><var v="export_name"/>.png</name>
				<!----><width expression="x0/2*(x1+x2)"><x v="tile_width"/><x v="map_width"/><x v="map_height"/></width>
				<!----><height expression="x0/2*(x1+x2)"><x v="tile_height"/><x v="map_width"/><x v="map_height"/></height><!----><image-contents><!--
	|--><image-loop foreach="layer"><as i="_layer"/><image-contents>
<!--|-->	<image-loop foreach="_layer.position"><as i="_position"/><as i="_tile"/><image-contents>
<!--|-->		<ivar v="_tile.image">
<!--|-->			<grid-x expression="x0/2*(x3-1+x1-x2)"><x v="tile_width"/><x v="_position.x"/><x v="_position.y"/><x v="map_height"/></grid-x>
<!--|-->			<grid-y expression="x0/2*(x1+x2)"><x v="tile_height"/><x v="_position.x"/><x v="_position.y"/></grid-y>
<!--|-->			<z-index expression="x0+x1+x2"><x v="_position.x"/><x v="_position.y"/><x v="_layer.index"/></z-index>
<!--|-->		</ivar>
<!--|-->	</image-contents></image-loop>
<!--|--></image-contents></image-loop><!--
	|||||||||||||||||||||||||||||||||--></image-contents></image-file>

</format>