<?xml version="1.0" encoding="UTF-8"?>
<format name="Defold Assets">

	<folder><!----><name><var v="export_name"/></name><!----><directory-contents>

		<image-file><!----><name><var v="export_name"/>.png</name>
					<!----><width expression="min(x0, 8)*x1"><x v="tile_count"/><x v="tile_size"/></width>
					<!----><height expression="ceil(x0/8)*x1"><x v="tile_count"/><x v="tile_size"/></height><!----><image-contents>	<!--
		|--><image-loop foreach="tile"><as i="_tile"/><image-contents>
<!--	|-->	<ivar v="_tile.image">
<!--	|-->		<grid-x expression="(x0%8)*x1"><x v="_tile.index"/><x v="tile_size"/></grid-x>
<!--	|-->		<grid-y expression="floor(x0/8)*x1"><x v="_tile.index"/><x v="tile_size"/></grid-y>
<!--	|-->	</ivar>
<!--	|--></image-contents></image-loop><!--
		|||||||||||||||||||||||||||||||||--></image-contents></image-file>

		<text-file><!----><name><var v="export_name"/>.tilesource</name><!----><text-contents><!--
		|-->image: "/<var v="export_name"/>.png"
<!--	|-->tile_width: <var v="tile_size"/>
<!--	|-->tile_height: <var v="tile_size"/>
<!--	|-->tile_margin: 0
<!--	|-->tile_spacing: 0
<!--	|-->collision: ""
<!--	|-->material_tag: "tile"
<!--	|-->extrude_borders: 2
<!--	|-->inner_padding: 0
<!--	|--><!--
		|||||||||||||||||||||||||||||||||--></text-contents></text-file>

	<!--|||||||||||||||||||||||||||||||||--></directory-contents></folder>

</format>