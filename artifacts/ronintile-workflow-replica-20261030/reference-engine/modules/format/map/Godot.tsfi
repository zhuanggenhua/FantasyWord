<?xml version="1.0" encoding="UTF-8"?>
<format name="Godot Assets">

	<folder><!----><name><var v="export_name"/></name><!----><directory-contents>

		<image-file><!----><name>tileset_<var v="export_name"/>.png</name>
					<!----><width expression="min(x0, 8)*x1"><x v="tile_count"/><x v="tile_width"/></width>
					<!----><height expression="ceil(x0/8)*x1"><x v="tile_count"/><x v="tile_height"/></height><!----><image-contents>	<!--
